{
	"schemaVersion": 1,
	"id": "fusionfix",
	"version": "${version}",
	"name": "FusionFix",
	"accessWidener": "fusionfix.accesswidener",
	"description": "This Minecraft mod fixes the Fusion API for Fabric for old intel processors that need a different texture loading method. Thanks to Supermartijn642 for allowing me to modify the original Fusion mod icon",
	"authors": [
		"MoltenHexagon"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/fusionfix/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.fusionfix.FusionFix"
		],
		"client": [
			"com.fusionfix.client.FusionFixClient"
		]
	},
	"mixins": [
		"fusionfix.mixins.json",
		{
			"config": "fusionfix.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fusion": ">=1.3.9 <2.0.0"
	}
}